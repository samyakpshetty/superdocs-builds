# Secrets — never commit. Real keys live here; only .env.example is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local review artifacts (exported docx, incoming markup, sqlite state).
# inbox/ holds documents real reviewers sent back — never commit someone's content.
*.db
*.sqlite3
*.docx
artifacts/
scratch/
# The working directories are tracked as empty so a fresh clone has them mounted and ready;
# nothing that lands inside them is ever committed.
inbox/*
!inbox/.gitkeep
outbox/*
!outbox/.gitkeep
data/*
!data/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
