# Copy to .env and fill in. .env is gitignored and never committed.
# The entire test suite and `make demo` run WITHOUT any of these (fake providers).
# You only need them for `make demo-live` — the real end-to-end proof.

# Provider selection: "fake" (default, deterministic, no network) or "live".
PROVIDER=fake

# SuperDocs — create at use.superdocs.app -> Settings -> API Keys (starts with sk_).
SUPERDOCS_API_KEY=your-superdocs-key-here

# Notion — create a connection at notion.so/my-integrations (Access token, starts with ntn_),
# then share the pages you want to review with the connection.
NOTION_TOKEN=your-notion-token-here

# Note: the Notion page to review is NOT configuration — it is per-request data. Pass it each
# time: `notion-review send --page-id <id>` (in production, a user action / API call / webhook
# supplies it). It deliberately does not live here.

# Postgres (compose sets this automatically inside the container).
DATABASE_URL=postgresql://review:review@localhost:5433/review

# Logging: "json" (structured, default) or "console".
LOG_FORMAT=json
